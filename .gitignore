*.jks
*.keystore
*.p12
*.b64
*.pem
*.key
*.pfx
credentials.env
signing/

# Stray LaTeX scratch files (see feature/hud-alert-feedback: t3_*.pdf etc. in repo root)
*.aux
*.log
*.out
*.toc
*.pdf
